    "@nestjs/platform-express": "^12.0.3",
    "@radio/contracts": "*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.13.5"
  }
}
