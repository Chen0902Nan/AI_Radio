{
  "name": "@radio/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:playback",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:playback": "tsc -p tsconfig.playback.json && node ../../scripts/finalize-playback-build.mts",
    "test": "npm run build -w @radio/contracts && npm run build:playback && node --test test/*.test.mts test/*.test.cts"
  },
  "dependencies": {
    "@radio/contracts": "*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0"
  }
}
