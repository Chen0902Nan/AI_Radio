{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": false,
    "outDir": "dist-playback",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@radio/contracts": [
        "../../packages/contracts/dist/cjs"
      ]
    },
    "rootDir": "src",
    "declaration": true
  },
  "include": [
    "src/playback/**/*.ts",
    "src/orchestration/**/*.ts"
  ]
}
