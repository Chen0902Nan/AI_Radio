{
  "name": "@radio/contracts",
  "version": "1.0.0",
  "private": true,
  "description": "节目契约：歌曲与 DJ 播报共用的数据形状、身份语义与结构校验（纯类型与校验，无 Node/React 依赖）",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "main": "./dist/cjs/index.js",
  "types": "./dist/esm/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:cjs && npm run build:esm",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json && node ../fix-esm-ext.mts && echo '{\"type\":\"module\"}' > dist/esm/package.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test ../../scripts/tests/program-contract.test.mts"
  }
}
